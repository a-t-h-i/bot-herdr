{
  "id": "root",
  "type": "row",
  "theme": {
    "light": "bot-herdr-light",
    "dark": "bot-herdr-dark"
  },
  "titlebar": "none",
  "toast": "bot-herdr",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "switch",
              "type": "block",
              "window_drag": true,
              "content": {
                "mod": "bot-herdr",
                "props": {
                  "view": "switch"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "stage",
              "type": "stack",
              "active": "pages",
              "children": [
                {
                  "id": "pages",
                  "type": "stack",
                  "active": "home",
                  "children": [
                    {
                      "id": "home",
                      "type": "block",
                      "content": {
                        "mod": "bot-herdr",
                        "props": {
                          "view": "home"
                        }
                      }
                    },
                    {
                      "id": "threads",
                      "type": "block",
                      "content": {
                        "mod": "bot-herdr",
                        "props": {
                          "view": "threads"
                        }
                      }
                    },
                    {
                      "id": "agents",
                      "type": "block",
                      "content": {
                        "mod": "bot-herdr",
                        "props": {
                          "view": "agents"
                        }
                      }
                    },
                    {
                      "id": "library",
                      "type": "block",
                      "content": {
                        "mod": "bot-herdr",
                        "props": {
                          "view": "library"
                        }
                      }
                    },
                    {
                      "id": "settings",
                      "type": "block",
                      "content": {
                        "mod": "bot-herdr",
                        "props": {
                          "view": "settings"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "terminals",
                  "type": "column",
                  "padding": 8,
                  "gap": 8,
                  "children": [
                    {
                      "id": "agents-tabs",
                      "type": "block",
                      "size": {
                        "px": 40
                      },
                      "content": {
                        "mod": "bot-herdr",
                        "props": {
                          "view": "agents",
                          "sub": "terminals"
                        }
                      }
                    },
                    {
                      "id": "panes",
                      "type": "row",
                      "gap": 8,
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 8,
                              "radius": 10,
                              "background": "background",
                              "lone": true,
                              "border": {
                                "width": 1,
                                "color": "border"
                              },
                              "focus": {
                                "width": 1,
                                "color": "accent"
                              },
                              "header": {
                                "content": {
                                  "mod": "pane"
                                },
                                "height": 30,
                                "position": "top",
                                "reveal": "always"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "bot-herdr",
            "props": {
              "view": "status"
            }
          }
        }
      ]
    }
  ]
}

{
  "id": "root",
  "type": "row",
  "theme": {
    "light": "bot-herdr-light",
    "dark": "bot-herdr-dark"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "switch",
              "type": "block",
              "size": {
                "px": 452
              },
              "window_drag": true,
              "content": {
                "mod": "bot-herdr",
                "props": {
                  "view": "switch"
                }
              }
            },
            {
              "id": "tabs",
              "type": "block",
              "window_drag": true,
              "content": {
                "mod": "tabs"
              }
            }
          ]
        },
        {
          "id": "pages",
          "type": "stack",
          "active": "chat",
          "children": [
            {
              "id": "chat",
              "type": "block",
              "content": {
                "mod": "bot-herdr",
                "props": {
                  "view": "chat"
                }
              }
            },
            {
              "id": "terminals",
              "type": "row",
              "padding": 8,
              "gap": 8,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "tasks",
              "type": "block",
              "content": {
                "mod": "bot-herdr",
                "props": {
                  "view": "work",
                  "tab": "tasks"
                }
              }
            },
            {
              "id": "plans",
              "type": "block",
              "content": {
                "mod": "bot-herdr",
                "props": {
                  "view": "work",
                  "tab": "plans"
                }
              }
            },
            {
              "id": "knowledge",
              "type": "block",
              "content": {
                "mod": "bot-herdr",
                "props": {
                  "view": "work",
                  "tab": "knowledge"
                }
              }
            },
            {
              "id": "settings",
              "type": "block",
              "content": {
                "mod": "bot-herdr",
                "props": {
                  "view": "settings"
                }
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
